val pico  = require "pico"
val art   = require "art"
val Float = require "float"

val colors = @{
    [:machine]    = :player,
    [:pipe.line]  = :black,
    [:pipe.curve] = :black,
    [:io.input]   = :black,
    [:io.output]  = art.juices,
}

val func Tile (tag, pos, img) {
    par {
        every :draw {
            pico.output.draw.buffer(img, @{'#',x=pos.x,y=pos.y,w=1,h=1,anc='NW'})
        }
    } with {
        var rect = @{ '#', x=pos.x, y=pos.y, w=1, h=1 }
        loop {
            await Double_Click(:left, \{pico.vs.pos_rect(it,rect)})
            spawn [HAND] Float @{ tag=tag, img=img, rot=0, clr=colors[tag] }
        }
    }
}

val func Panel (r) {
    val io = pico.cv.rect(@{'%',x=25,y=50,w=30,h=80,up=r})
    val ps = pico.cv.rect(@{'%',x=75,y=50,w=30,h=80,up=r})
    par {
        every :draw {
            pico.zet.crop(r)
            pico.zet.color.clear('white')
            ;;pico.push @{}
            pico.output.clear()
            pico.zet.color.draw('black')
            pico.zet.style(:stroke)
            pico.output.draw.rect(io)
            pico.output.draw.rect(ps)
        }
    } with {
        spawn Tile(:io.input,   pico.cv.pos(@{'%',x=33,y=50,up=io}), art.imgs.io.input)
        spawn Tile(:io.output,  pico.cv.pos(@{'%',x=67,y=50,up=io}), art.imgs.io.output)
        spawn Tile(:machine,    pico.cv.pos(@{'%',x=50,y=50,up=r}),  art.imgs.machine)
        spawn Tile(:pipe.line,  pico.cv.pos(@{'%',x=33,y=50,up=ps}), art.imgs.pipe.line)
        spawn Tile(:pipe.curve, pico.cv.pos(@{'%',x=67,y=50,up=ps}), art.imgs.pipe.curve)
        await(false)
    } with {
        every :draw {
            pico.zet.color.clear('black')
            pico.zet.crop()
            ;; pico.pop()
        }
    }
}

Panel
