require "atmos.env.pico"
set pico = require "pico"

;;val Menu = require "menu"

set R = 6

pico.zet.window @{
    title = "Fábrica",
}
pico.zet.dim @{
    '!', w=800, h=800
}

;; MAP layer
do {
    pico.layer.empty(:root, :map, @{w=12,h=12}, @{w=R,h=R})
    pico.zet.layer :map
    pico.zet.view @{
        color  = :red,
        grid   = true,
        target = @{'%', x=0.5, y=0, w=1, h=0.80, anchor='N'},
    }
}

;; MENU layer
do {
    pico.layer.empty(:root, :menu, @{w=1000, h=200})
    pico.zet.layer :menu
    pico.zet.view @{
        color  = :green,
        target = @{'%', x=0.5, y=1, w=1, h=0.20, anchor='S'}
    }
}

pico.zet.layer :root

await(false)
