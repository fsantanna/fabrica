require "atmos.env.pico"
set pico = require "pico"

val R = 6

pico.zet.window @{
    title = "Fábrica",
}
pico.zet.dim @{
    '!', w=800, h=800
}

do {
    pico.layer.empty(:map, @{w=1000, h=800})
    pico.zet.layer(:map)
    pico.zet.view @{
        grid   = true,
        target = @{'%', x=0.5, y=0, w=1, h=0.80, anchor='N'},
        dim    = @{'#', w=10, h=10 },
        tile   = @{w=R, h=R},
    }
}

do {
    pico.layer.empty(:menu, @{w=1000, h=200})
    pico.zet.layer(:menu)
    pico.zet.view @{
        target = @{'%', x=0.5, y=1, w=1, h=0.20, anchor='S'}
    }
}

spawn {
    every :draw {
        pico.zet.layer(:map)
        pico.zet.color.clear('black')
        pico.output.clear()

        pico.zet.layer(:menu)
        pico.zet.color.clear('white')
        pico.output.clear()

        pico.zet.layer()
        pico.output.draw.layer(:map)
        pico.output.draw.layer(:menu)
    }
}

await(false)
