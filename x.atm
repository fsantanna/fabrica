require "atmos.env.pico"
set pico = require "pico"

val Menu = require "menu"

set R = 6

pico.zet.window @{
    title = "Fábrica",
}
pico.zet.dim @{
    '!', w=800, h=800
}

func Double_Click (but, tag) {
    loop {
        val m = await(:mouse.button.dn, but, \{
            val m = pico.get.mouse('%')
            pico.vs.pos_rect(m,tag)
        })
        watching @.200 {
            await(:mouse.button.dn, but, \{ it === m })
            return()
        }
    }
}

;; MAP
do {
    pico.layer.empty(:window, :map, true, @{'!',w=12,h=12}, @{w=R,h=R})
    pico.zet.layer :map
    pico.zet.effect @{
        grid  = true,
    }
    pico.zet.scene @{
        target = @{'%', x=0.5, y=0, w=1, h=0.85, anchor='N'},
    }
}

;; MENU
spawn Menu @{
    '%', x=0.5, y=1, w=1, h=0.15, anchor='S'
}

pico.zet.layer :window

await(false)
