require "atmos.env.pico"
set pico = require "pico"

val Menu = require "menu"

set R = 6

pico.zet.window @{
    title = "Fábrica",
}
pico.zet.dim @{
    '!', w=800, h=800
}

;; MAP
do {
    pico.layer.empty(:root, :map, @{w=12,h=12}, @{w=R,h=R})
    pico.zet.layer :map
    pico.zet.show @{
        grid  = true,
    }
    pico.zet.view @{
        target = @{'%', x=0.5, y=0, w=1, h=0.80, anchor='N'},
    }
}

;; MENU
spawn Menu @{
    '%', x=0.5, y=1, w=1, h=0.20, anchor='S'
}

pico.zet.layer :root

await(false)
