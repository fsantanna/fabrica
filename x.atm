require "atmos.env.pico"
set pico = require "pico"
val x = require "atmos.x"

val Menu = require "menu"

set R = 6

pico.zet.window @{
    title = "Fábrica",
}
pico.zet.dim @{
    '!', w=800, h=800
}

func Clicks (but, f) {
    val m = await(:mouse.button.dn, but, f)
    watching @.200 {
        await(:mouse.button.dn, but, \{ it === m })
        return(2)
    }
    1
}

func Double_Click (but, tag) {
    loop {
        val m = await(:mouse.button.dn, but, \{
            pico.vs.pos.rect(it, tag)
        })
        watching @.200 {
            await(:mouse.button.dn, but, \{ it === m })
            return()
        }
    }
}

;; MAP
do {
    pico.layer.empty (
        :window, :map, true,
        @{'!',w=12,h=12}, @{w=R,h=R},
        @{'%', x=0.5, y=0, w=1, h=0.85, anchor='N'}
    )
    pico.zet.layer :map
    pico.zet.effect @{ grid=true }
}

;; MENU
spawn Menu @{
    '%', x=0.5, y=1, w=1, h=0.15, anchor='S'
}

pico.zet.layer :window

await(false)
