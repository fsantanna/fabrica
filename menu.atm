val art = require "art"

val func Tile (tag, img, tgt) {
    set img = pico.layer.pixmap(:menu, tag, img)

    pico.zet.layer(tag)
    pico.zet.view @{
        target = tgt,
    }
    
    await(false)
    ;;;
        loop {
            await Double_Click(:left, \{pico.vs.pos_rect(it,rect)})
            spawn [HAND] Float @{ tag=tag, img=img, rot=0, clr=colors[tag] }
        }
    ;;;
}

val func Menu (tgt) {
    pico.layer.empty(:root, :menu, @{w=100, h=20})
    pico.zet.layer :menu
    pico.zet.show @{
        color = :white,
    }
    pico.zet.view @{
        target = tgt,
    }
    pico.zet.draw @{
        color = :black,
        style = :stroke,
    }

    val io = @{ '%', x=0.25, y=0.5, w=0.3, h=0.8 }
    val ps = @{ '%', x=0.75, y=0.5, w=0.3, h=0.8 }

    spawn Tile(:machine,    art.imgs.machine,    @{'%',x=0.5,y=0.5,h=0.5})

    spawn Tile(:io.input,   art.imgs.io.input,   @{'%',x=0.3,y=0.5,h=0.5,up=io})
    spawn Tile(:io.output,  art.imgs.io.output,  @{'%',x=0.7,y=0.5,h=0.5,up=io})

    spawn Tile(:pipe.line,  art.imgs.pipe.line,  @{'%',x=0.3,y=0.5,h=0.5,up=ps})
    spawn Tile(:pipe.curve, art.imgs.pipe.curve, @{'%',x=0.7,y=0.5,h=0.5,up=ps})

    every :draw {
        pico.zet.layer :menu
        pico.output.draw.rect(io)
        pico.output.draw.rect(ps)
    }
}

Menu
