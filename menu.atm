val art = require "art"

val func Tile (parent, tag, img, tgt) {
    pico.layer.pixmap(parent, tag, img, tgt)
    await(false)
    ;;;
        var rect = @{ '#', x=pos.x, y=pos.y, w=1, h=1 }
        loop {
            await Double_Click(:left, \{pico.vs.pos_rect(it,rect)})
            spawn [HAND] Float @{ tag=tag, img=img, rot=0, clr=colors[tag] }
        }
    ;;;
}

val func Menu (tgt) {
    pico.layer.empty(:window, :menu, false, tgt)
    pico.zet.layer :menu
    pico.zet.effect @{
        color = :white,
    }
    pico.zet.pencil @{
        color = :black,
        style = :stroke,
    }

    val io = @{ '%', x=0.25, y=0.5, w=0.3, h=0.8 }
    val ps = @{ '%', x=0.75, y=0.5, w=0.3, h=0.8 }

    pico.output.clear()
    pico.output.draw.rect(io)
    pico.output.draw.rect(ps)

    pico.layer.empty(:menu, :io, false, io)
    pico.zet.layer :io
    pico.zet.effect @{
        color = :white,
    }

    pico.layer.empty(:menu, :ps, false, ps)
    pico.zet.layer :ps
    pico.zet.effect @{
        color = :white,
    }

    spawn Tile(:menu, :machine,  art.imgs.machine,    @{'%',x=0.5,y=0.5,h=0.5})

    spawn Tile(:io, :io.input,   art.imgs.io.input,   @{'%',x=0.3,y=0.5,h=0.5})
    spawn Tile(:io, :io.output,  art.imgs.io.output,  @{'%',x=0.7,y=0.5,h=0.5})

    spawn Tile(:ps, :pipe.line,  art.imgs.pipe.line,  @{'%',x=0.3,y=0.5,h=0.5})
    spawn Tile(:ps, :pipe.curve, art.imgs.pipe.curve, @{'%',x=0.7,y=0.5,h=0.5})

    pico.zet.layer :window
    await(false)
}

Menu
